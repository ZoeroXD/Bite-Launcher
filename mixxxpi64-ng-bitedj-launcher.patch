diff --git a/stage-mixxx/03-kiosk/files/bite-launcher-open b/stage-mixxx/03-kiosk/files/bite-launcher-open
new file mode 100755
index 0000000..d6d8c27
--- /dev/null
+++ b/stage-mixxx/03-kiosk/files/bite-launcher-open
@@ -0,0 +1,25 @@
+#!/bin/sh
+# bite-launcher-open          Bite Launcher desktop/menu shortcut: autostart on, switch to the launcher.
+# bite-launcher-open toggle   Ctrl+Alt+D (labwc key binding): same as the FLX4 4 BEAT/EXIT hold.
+#   Launcher running     -> autostart off, wrapper then launcher stopped, Pi desktop back
+#   Launcher not running -> autostart on, launcher started
+# Uses the FLX4 macro's bite-mode when installed (it also hides/restores the taskbar and desktop).
+OFF="$HOME/.config/bite-launcher/autostart-off"
+U=$(id -u)
+PY='^python3 /opt/bitedj-launcher/bitedj_launcher[.]py'   # the launcher itself, not an editor or grep on the file
+BM=""
+for m in "$HOME/bin/bite-mode" /usr/local/bin/bite-mode; do [ -x "$m" ] && { BM=$m; break; }; done
+
+if [ "$1" = toggle ] && pgrep -u "$U" -f "$PY" >/dev/null; then
+  mkdir -p "${OFF%/*}" && touch "$OFF"
+  [ -n "$BM" ] && exec "$BM" desktop
+  pkill -u "$U" -f /usr/local/bin/bitedj-launcher    # wrapper first, or it restarts the launcher
+  pkill -u "$U" -f '(^|/)swaybg -c #000000'
+  exec pkill -u "$U" -f "$PY"
+fi
+
+rm -f "$OFF"
+pgrep -u "$U" -f "$PY" >/dev/null && exit 0     # already on screen
+[ -n "$BM" ] && exec "$BM" launcher
+pgrep -u "$U" -f '(^|/)swaybg -c #000000' >/dev/null || setsid -f swaybg -c '#000000' >/dev/null 2>&1 </dev/null
+exec setsid -f /usr/local/bin/bitedj-launcher >/dev/null 2>&1 </dev/null
diff --git a/stage-mixxx/03-kiosk/files/bite-launcher.desktop b/stage-mixxx/03-kiosk/files/bite-launcher.desktop
new file mode 100644
index 0000000..4ebca9f
--- /dev/null
+++ b/stage-mixxx/03-kiosk/files/bite-launcher.desktop
@@ -0,0 +1,12 @@
+[Desktop Entry]
+Type=Application
+Version=1.0
+Name=Bite Launcher
+GenericName=BiteDJ Launcher
+Comment=Switch to the Bite Launcher (waits for a BiteDJ controller, then launches BiteDJ)
+Exec=/usr/local/bin/bite-launcher-open
+Icon=/opt/bitedj-launcher/bite-launcher.png
+Terminal=false
+Categories=AudioVideo;Audio;Music;
+Keywords=BiteDJ;DJ;Mixxx;Controller;
+StartupWMClass=bitedj-launcher
