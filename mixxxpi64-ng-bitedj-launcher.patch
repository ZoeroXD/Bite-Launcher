diff --git a/stage-mixxx/03-kiosk/00-run.sh b/stage-mixxx/03-kiosk/00-run.sh
index 1aa224a..eeb2014 100755
--- a/stage-mixxx/03-kiosk/00-run.sh
+++ b/stage-mixxx/03-kiosk/00-run.sh
@@ -5,8 +5,30 @@ install -m 644 files/autostart "$H/.config/labwc/autostart"
 install -m 644 files/rc.xml "$H/.config/labwc/rc.xml"
 install -m 755 files/djrig-launch "${ROOTFS_DIR}/usr/local/bin/djrig-launch"
 install -m 755 files/djrig-display "${ROOTFS_DIR}/usr/local/bin/djrig-display"
+install -d "${ROOTFS_DIR}/opt/bitedj-launcher"
+install -m 644 files/VERSION "${ROOTFS_DIR}/opt/bitedj-launcher/VERSION"
+install -m 755 files/bitedj_launcher.py "${ROOTFS_DIR}/opt/bitedj-launcher/bitedj_launcher.py"
+install -m 755 files/bitedj-launcher "${ROOTFS_DIR}/usr/local/bin/bitedj-launcher"
+install -m 755 files/bite-launcher-open "${ROOTFS_DIR}/usr/local/bin/bite-launcher-open"
+install -m 755 files/bite-mode "${ROOTFS_DIR}/usr/local/bin/bite-mode"
+for source in bite_runtime.py bite_session.py bitedj-hold.py configure_session.py configure_boot.py; do
+  install -m 755 "files/$source" "${ROOTFS_DIR}/opt/bitedj-launcher/$source"
+done
+# Apply the same startup integration to the image without executing its clients.
+PYTHONPATH=files python3 -c 'from pathlib import Path; import sys; from configure_session import configure; configure(Path(sys.argv[1]), system_rc=Path(sys.argv[2]))' "$H" "${ROOTFS_DIR}/etc/xdg/labwc/rc.xml"
+python3 files/configure_boot.py "${ROOTFS_DIR}/etc/xdg/labwc/autostart"
+install -d "$H/bin" "$H/.config/systemd/user/default.target.wants"
+install -m 755 files/bite-mode "$H/bin/bite-mode"
+install -m 644 files/bitedj-hold.service "$H/.config/systemd/user/bitedj-hold.service"
+ln -sf ../bitedj-hold.service "$H/.config/systemd/user/default.target.wants/bitedj-hold.service"
+install -m 644 files/bite-launcher.png "${ROOTFS_DIR}/opt/bitedj-launcher/bite-launcher.png"
+install -m 644 files/bite-launcher.desktop "${ROOTFS_DIR}/usr/share/applications/bite-launcher.desktop"
+install -d "$H/Desktop" && install -m 755 files/bite-launcher.desktop "$H/Desktop/bite-launcher.desktop"
 install -m 644 files/djrig.conf "${ROOTFS_DIR}/etc/djrig.conf"
 cat >> "$H/.bash_profile" <<'P'
 # Start the DJ session on the local console only (SSH sessions are unaffected)
 if [ -z "$WAYLAND_DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then exec labwc; fi
 P
+# Hide the rainbow boot screen (GPU firmware splash)
+CFG="${ROOTFS_DIR}/boot/firmware/config.txt"; [ -f "$CFG" ] || CFG="${ROOTFS_DIR}/boot/config.txt"
+grep -qE '^\s*disable_splash\s*=\s*1' "$CFG" || printf '\n# Bite Launcher: hide the rainbow boot screen\n[all]\ndisable_splash=1\n# end Bite Launcher\n' >> "$CFG"
